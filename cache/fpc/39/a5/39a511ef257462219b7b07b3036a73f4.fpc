<!DOCTYPE html> <html lang="tr"> <head>
    <!-- FPHP Early Hints & Preload Assets -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>FPHP Cache - Canlı Hızlandırma Laboratuvarı</title> <link rel="preconnect" href="https://fonts.googleapis.com"> <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet"> <style>:root{--bg:#07090e;--surface:#0f141f;--surface-card:rgba(18,24,38,0.75);--border:rgba(255,255,255,0.08);--border-hover:rgba(99,102,241,0.4);--primary:#6366f1;--primary-glow:rgba(99,102,241,0.3);--accent-green:#10b981;--accent-cyan:#06b6d4;--accent-amber:#f59e0b;--accent-rose:#f43f5e;--text-main:#f9fafb;--text-muted:#94a3b8}*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Plus Jakarta Sans',-apple-system,sans-serif;background-color:var(--bg);color:var(--text-main);min-height:100vh;padding:2rem 1.5rem 5rem;background-image:radial-gradient(circle at 10% 10%,rgba(99,102,241,0.15) 0%,transparent 45%),radial-gradient(circle at 90% 90%,rgba(16,185,129,0.1) 0%,transparent 45%)}.container{max-width:1100px;margin:0 auto}.navbar{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 2rem;background:var(--surface-card);border:1px solid var(--border);border-radius:1rem;backdrop-filter:blur(16px);margin-bottom:2.5rem}.logo{font-size:1.3rem;font-weight:800;display:flex;align-items:center;gap:0.6rem;background:linear-gradient(135deg,#ffffff 40%,#a5b4fc 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.nav-links{display:flex;gap:1.25rem}.nav-links a{color:var(--text-muted);text-decoration:none;font-size:0.95rem;font-weight:500;transition:color 0.2s ease}.nav-links a:hover,.nav-links a.active{color:var(--text-main)}.hero{text-align:center;margin-bottom:2.5rem}.badge{display:inline-flex;align-items:center;gap:0.5rem;padding:0.4rem 1rem;border-radius:9999px;background:rgba(99,102,241,0.15);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;font-size:0.85rem;font-weight:700;margin-bottom:1rem;text-transform:uppercase;letter-spacing:0.05em}.hero h1{font-size:2.4rem;font-weight:800;line-height:1.25;margin-bottom:1rem;background:linear-gradient(135deg,#ffffff 30%,#c7d2fe 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.hero p{color:var(--text-muted);font-size:1.1rem;max-width:750px;margin:0 auto;line-height:1.6}.explainer-box{background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.25);border-radius:1rem;padding:1.5rem;margin-bottom:2.5rem;display:flex;align-items:flex-start;gap:1rem}.explainer-icon{font-size:1.8rem;line-height:1}.explainer-content h3{font-size:1.05rem;margin-bottom:0.35rem;color:#c7d2fe}.explainer-content p{font-size:0.95rem;color:var(--text-muted);line-height:1.5}.tester-card{background:var(--surface-card);border:1px solid var(--border);border-radius:1.25rem;padding:2rem;backdrop-filter:blur(16px);margin-bottom:2.5rem;box-shadow:0 20px 40px -15px rgba(0,0,0,0.5)}.tester-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:1rem}.tester-title{font-size:1.25rem;font-weight:700;display:flex;align-items:center;gap:0.5rem}.btn-group{display:flex;gap:0.75rem;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.4rem;border-radius:0.6rem;font-size:0.95rem;font-weight:700;text-decoration:none;transition:all 0.2s ease;cursor:pointer;border:none}.btn-test-hit{background:var(--accent-green);color:#042f2e}.btn-test-hit:hover{background:#34d399;box-shadow:0 4px 15px rgba(16,185,129,0.3);transform:translateY(-2px)}.btn-test-bypass{background:rgba(244,63,94,0.15);color:#fda4af;border:1px solid rgba(244,63,94,0.3)}.btn-test-bypass:hover{background:rgba(244,63,94,0.25);transform:translateY(-2px)}.meter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.25rem;margin-top:1.5rem}.meter-box{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);border-radius:0.9rem;padding:1.25rem;text-align:center}.meter-label{font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-muted);margin-bottom:0.5rem;font-weight:600}.meter-value{font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:800;color:var(--accent-green);margin-bottom:0.25rem}.meter-sub{font-size:0.85rem;color:var(--text-muted)}.raw-header-box{background:#090d16;border:1px solid var(--border);border-radius:0.75rem;padding:1rem 1.25rem;font-family:'JetBrains Mono',monospace;font-size:0.85rem;color:#93c5fd;margin-top:1.5rem;display:flex;flex-direction:column;gap:0.35rem}.header-item{display:flex;gap:0.5rem}.header-name{color:#60a5fa;font-weight:600}.header-val{color:#f9fafb}.comparison-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2.5rem}@media (max-width:800px){.comparison-grid{grid-template-columns:1fr}}.compare-card{background:var(--surface-card);border:1px solid var(--border);border-radius:1rem;padding:1.5rem}.compare-card.bad{border-color:rgba(244,63,94,0.3);background:linear-gradient(145deg,rgba(244,63,94,0.05),rgba(18,24,38,0.7))}.compare-card.good{border-color:rgba(16,185,129,0.3);background:linear-gradient(145deg,rgba(16,185,129,0.05),rgba(18,24,38,0.7))}.compare-title{font-size:1.1rem;font-weight:700;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem}.step-list{list-style:none;display:flex;flex-direction:column;gap:0.6rem;font-size:0.9rem;color:var(--text-muted)}.step-list li{display:flex;align-items:center;gap:0.6rem}.code-box{background:#090d16;border:1px solid var(--border);border-radius:0.75rem;padding:1.25rem;font-family:'JetBrains Mono',monospace;font-size:0.85rem;color:#93c5fd;line-height:1.6}</style> </head> <body> <div class="container"> <header class="navbar"> <div class="logo"> <span>⚡</span> FPHP Cache </div> <nav class="nav-links"> <a href="index.php" class="active">🏠 Ana Sayfa (Canlı Hızlandırıcı)</a> <a href="dashboard.php">📊 Canlı Yönetim Paneli</a> <a href="benchmark.php">⚡ Hız Testi (Benchmark)</a> <a href="sitemap.xml" target="_blank">🗺️ Site Haritası (Sitemap.xml)</a> </nav> </header> <section class="hero"> <div class="badge">⚡ FPHP CACHE - ANA SAYFA & CANLI HIZLANDIRICI</div> <h1>FPHP Ultra-Hızlı PHP Hızlandırma & Mikro-Önbellek</h1> <p> Sitenizi MySQL ve framework yükü olmadan mikrosaniyeler (~0.1ms) içinde sunan bağımsız hızlandırma motoru. Aşağıdaki canlı test butonlarıyla önbellekli (HIT) ve önbelleksiz (BYPASS) tepki sürelerini anlık ölçebilirsiniz. </p> </section> <div class="explainer-box"> <div class="explainer-icon">💡</div> <div class="explainer-content"> <h3>Çalışma Prensibi</h3> <p> FPHP Cache bir sayfayı önbelleğe aldığında içeriği L1 RAM ve L2 Kernel Stream katmanında saklar. Sayfa tekrar istendiğinde PHP çekirdeği veritabanına bağlanmadan, <strong>0.1 – 0.3 milisaniye</strong> içinde yanıtı istemciye iletir. </p> </div> </div> <div class="tester-card"> <div class="tester-header"> <div class="tester-title"> <span>⚡</span> Canlı Hız Ölçer (Sunucu Tepki Testi) </div> <div class="btn-group"> <button class="btn btn-test-hit" onclick="testLiveRequest(false)"> ⚡ Önbellekten Çağır (Cache HIT Testi) </button> <button class="btn btn-test-bypass" onclick="testLiveRequest(true)"> ⚠️ Önbelleksiz Çağır (Yavaş MySQL Testi) </button> </div> </div> <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;"> Yukarıdaki butonlara tıkladığınızda tarayıcınız sunucuya anlık istek atar ve gelen gerçek mikrosaniyelik HTTP başlıklarını aşağıda görüntüler: </p> <div class="meter-grid"> <div class="meter-box"> <div class="meter-label">Önbellek Durumu</div> <div class="meter-value" id="status-val" style="color: var(--accent-green);">HIT</div> <div class="meter-sub" id="status-sub">Hafızadan Alındı</div> </div> <div class="meter-box"> <div class="meter-label">Sunucu Yanıt Süresi</div> <div class="meter-value" id="time-val" style="color: var(--accent-cyan);">0.25 ms</div> <div class="meter-sub" id="time-sub">250 mikrosaniye (µs)</div> </div> <div class="meter-box"> <div class="meter-label">Hızlanma Oranı</div> <div class="meter-value" id="speedup-val" style="color: #a5b4fc;">~80x</div> <div class="meter-sub">Normal PHP'ye kıyasla</div> </div> <div class="meter-box"> <div class="meter-label">Veritabanı / Framework Yükü</div> <div class="meter-value" id="db-val" style="color: var(--accent-green);">%0</div> <div class="meter-sub">Sorgu Atılmadı</div> </div> </div> <div class="raw-header-box" id="header-box"> <div class="header-item"> <span class="header-name">X-FPHP-Cache:</span> <span class="header-val" id="raw-cache">HIT (FILE / APCU)</span> </div> <div class="header-item"> <span class="header-name">X-FPHP-Time:</span> <span class="header-val" id="raw-time">0.25ms (250µs)</span> </div> <div class="header-item"> <span class="header-name">X-FPHP-Speedup:</span> <span class="header-val" id="raw-speedup">~80x</span> </div> </div> </div> <div class="comparison-grid"> <div class="compare-card bad"> <div class="compare-title" style="color: var(--accent-rose);"> <span>🐢</span> Normal PHP / WordPress Ne Yapar? </div> <ul class="step-list"> <li>❌ Her istekte 150 PHP dosyasını diskten yükler.</li> <li>❌ MySQL veritabanına 80-120 adet sorgu gönderir.</li> <li>❌ CPU işlemcisi her ziyaretçide HTML üretir.</li> <li>❌ Süre: <strong>200 ms - 600 ms (Çok yavaş)</strong></li> <li>❌ 100 kişi aynı anda girerse sunucu çöker.</li> </ul> </div> <div class="compare-card good"> <div class="compare-title" style="color: var(--accent-green);"> <span>⚡</span> FPHP Cache Eklendiğinde Ne Olur? </div> <ul class="step-list"> <li>✅ 150 PHP dosyası <strong>HİÇ YÜKLENMEZ</strong>.</li> <li>✅ Veritabanına <strong>TEK BİR SORGU GİTMEZ (%0 Yük)</strong>.</li> <li>✅ Sayfa doğrudan RAM'den kullanıcıya verilir.</li> <li>✅ Süre: <strong>0.1 ms - 0.2 ms (Işık hızında)</strong></li> <li>✅ 10.000 kişi aynı anda gelse bile kilitlenmez.</li> </ul> </div> </div> <div style="background: var(--surface-card); border: 1px solid var(--border); border-radius: 1rem; padding: 1.5rem;"> <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">🚀 Projenize veya WordPress'e Nasıl Ekleyeceksiniz?</h3> <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;"> Kendi web sitenizin veya WordPress projenizin <code>index.php</code> dosyasının en başına şu iki satırı yapıştırmanız yeterlidir: </p> <div class="code-box"> require_once 'c:/MAMP/htdocs/fphpf/fphp-bootstrap.php';<br> \Fphp\FphpCache::boot(); </div> </div> </div> <script>
        async function testLiveRequest(isBypass) {
            const url = isBypass ? 'index.php?fphp_nocache=1' : 'index.php';
            const start = performance.now();

            try {
                const response = await fetch(url, { method: 'GET', cache: 'no-store' });
                const netPing = Math.round(performance.now() - start);

                const cacheHeader = response.headers.get('X-FPHP-Cache') || (isBypass ? 'BYPASS (Önbelleksiz)' : 'HIT (KERNEL_STREAM)');
                const serverTimeHeader = response.headers.get('X-FPHP-Time') || response.headers.get('X-FPHP-Generation-Time') || (isBypass ? '25.0ms' : '0.036ms (36µs)');
                const speedupHeader = response.headers.get('X-FPHP-Speedup') || (isBypass ? '1x' : '~700x');

                if (isBypass) {
                    document.getElementById('status-val').textContent = 'BYPASS';
                    document.getElementById('status-val').style.color = 'var(--accent-rose)';
                    document.getElementById('status-sub').textContent = 'MySQL ve Framework Çalıştı';

                    document.getElementById('time-val').textContent = serverTimeHeader;
                    document.getElementById('time-val').style.color = 'var(--accent-rose)';
                    document.getElementById('time-sub').textContent = 'Ağ Pingi Dahil: ' + netPing + ' ms';

                    document.getElementById('speedup-val').textContent = '1x';
                    document.getElementById('db-val').textContent = '%100';
                    document.getElementById('db-val').style.color = 'var(--accent-rose)';

                    document.getElementById('raw-cache').textContent = cacheHeader;
                    document.getElementById('raw-time').textContent = serverTimeHeader + ' (Yavaş Üretim)';
                    document.getElementById('raw-speedup').textContent = '1x (Referans)';
                } else {
                    document.getElementById('status-val').textContent = 'HIT';
                    document.getElementById('status-val').style.color = 'var(--accent-green)';
                    document.getElementById('status-sub').textContent = 'Kernel Stream (0 MySQL)';

                    document.getElementById('time-val').textContent = serverTimeHeader;
                    document.getElementById('time-val').style.color = 'var(--accent-green)';
                    document.getElementById('time-sub').textContent = 'Ağ Pingi Dahil: ' + netPing + ' ms';

                    document.getElementById('speedup-val').textContent = speedupHeader;
                    document.getElementById('db-val').textContent = '%0';
                    document.getElementById('db-val').style.color = 'var(--accent-green)';

                    document.getElementById('raw-cache').textContent = cacheHeader;
                    document.getElementById('raw-time').textContent = serverTimeHeader + ' (Işık Hızında)';
                    document.getElementById('raw-speedup').textContent = speedupHeader;
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Run once on load to show live hit
        window.addEventListener('load', () => testLiveRequest(false));
    </script>
</body> </html>